@import url("https://fonts.googleapis.com/css2?family=Actor&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap");

:root{
  --navbar-h:60px;
  --sidebar-w:240px;
  --sidebar-w-collapsed:76px;
  --sidebar-w-mobile:min(82vw, 320px);
  --nav-min-h:48px;
  --sub-nav-min-h:44px;
  --background:#F8F5EF;
  --surface:#FFFDF8;
  --primary:#5A3E2B;
  --secondary:#B45A3C;
  --accent:#C89B3C;
  --text:#2F2A25;
  --text-secondary:#6F665E;
  --border:#DDD0BB;
  --nav-background: rgba(255, 253, 248, 0.72);
  --nav-border: rgba(221, 208, 187, 0.4);
  --nav-shadow: 0 18px 35px rgba(16, 24, 40, 0.12);
  --success:#647A3D;
  --error:#B43B3B;
  --bg-page:var(--background);
  --bg-card:var(--surface);
  --bg-sidebar:var(--surface);
  --border-color:var(--border);
  --text-main:var(--text);
  --text-sub:var(--text-secondary);
  --text-muted:var(--text-secondary);
  --accent-blue:var(--secondary);
  --accent-green:var(--success);
  --accent-green-bg:rgba(100,122,61,0.12);
  --accent-red:var(--error);
  --font-sans:'Poppins', sans-serif;
  --font-serif:'Georgia','Times New Roman',serif;
  --radius-lg:16px;
  --radius-md:10px;
  --shadow-card:0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06);
  --transition-fast:.2s ease;
  --transition-medium:.3s ease;
}

[data-theme="dark"]{
  --background:#171311;
  --surface:#231C18;
  --primary:#D4AF37;
  --secondary:#C56A45;
  --accent:#E0C067;
  --text:#F5F1E8;
  --text-secondary:#C7B9A3;
  --border:#43352C;
  --nav-background: rgba(35, 28, 24, 0.75);
  --nav-border: rgba(67, 53, 44, 0.45);
  --nav-shadow: 0 18px 35px rgba(0, 0, 0, 0.35);
  --success:#8AA05B;
  --error:#D06A6A;
  --bg-page:var(--background);
  --bg-card:var(--surface);
  --bg-sidebar:var(--surface);
  --border-color:var(--border);
  --text-main:var(--text);
  --text-sub:var(--text-secondary);
  --text-muted:var(--text-secondary);
  --accent-blue:var(--secondary);
  --accent-green:var(--success);
  --accent-green-bg:rgba(138,160,91,0.12);
  --accent-red:var(--error);
}

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: var(--primary); /* atau rgba(0,0,0,0.3) */
    border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
    transition: var(--transition-medium)
}

*{box-sizing:border-box;}

body{
  margin:0;
  background:var(--surface);
  font-family:'Poppins', sans-serif;
  color:var(--text-main);
  transition:background var(--transition-medium), color var(--transition-medium);
  overflow-x:hidden;
}

.cursor {
    position: fixed;
    width: 60px;
    height: 60px;
    background: var(--accent);
    border-radius: 50%;
    filter: blur(20px);
    opacity: 0.3;
    pointer-events: none;
    z-index: 999999;
    transform: translate(-50%, -50%);
}

a { 
  text-decoration:none; 
  color:inherit;
}

.app-shell{
  position:relative;
  max-height:100vh;
  max-height:100dvh;
}

/* ===== TOP NAVBAR ===== */
.topnav{
  position:fixed;
  top:0; left:0; right:0;
  height:var(--navbar-h);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 24px;
  background:var(--nav-background);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  z-index:100;
  overflow-x:hidden;
  transition:transform var(--transition-medium);
}

.app-shell.nav-hidden .topnav{
  transform:translateY(-100%);
}

.app-shell.nav-hidden .sidebar{
  top:0;
}

.app-shell.nav-hidden .main-content{
  margin-top:0;
}

.topnav-left{
  display:flex;
  align-items:center;
  gap: 0.75rem;
}

.hamburger-btn{
  width:50px; 
  height:50px;
  border:none;
  background:none;
  border-radius:var(--radius-md);
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--text-main);
  transition:background var(--transition-fast);
  margin-left: 2rem;
}

.hamburger-btn svg{ width:22px; height:22px; }

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  color:var(--text-main);
}
.brand-icon{ 
  width:26px; 
  height:26px; 
  color:var(--accent-blue); 
  flex-shrink:0; 
}

.brand-text{ 
  font-size:1.5rem; 
  font-weight:700; 
  white-space:nowrap; 
}

.brand-text strong{
  color:var(--accent-blue); 
  font-weight:800; 
}

.topnav-right{
  display:flex;
  align-items:center;
  gap:18px;
}

.search-bar{
  display:flex;
  align-items:center;
  border:1px solid var(--border-color);
  border-radius:999px;
  overflow:hidden;
  background:var(--bg-page);
}
.search-bar input{
  border:none;
  background:none;
  padding:9px 16px;
  font-size:.88rem;
  width:clamp(90px, 18vw, 220px);
  outline:none;
  color:var(--text-main);
  font-family:var(--font-sans);
}
.search-btn{
  border:none;
  background:var(--accent-blue);
  color:#fff;
  width:38px; height: 40px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.search-btn svg{ width:16px; height:16px; }

.theme-switch {
  padding: 0;
  width: 64px;
  height: 36px;
  background: transparent;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  overflow: hidden;
}

.theme-switch__track {
  width: 100%;
  height: 100%;
  padding: 4px;
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, var(--accent), var(--secondary));
  border-radius: 999px;
}

.theme-switch__thumb {
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background-color: var(--surface);
  color: var(--primary);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
}

.theme-switch.active .theme-switch__thumb {
  transform: translateX(28px);
  background-color: var(--surface);
  color: var(--accent);
}

.theme-switch__icon {
  font-size: 1rem;
  line-height: 1;
}

.icon-btn{
  position:relative;
  width:36px; height:36px;
  border:none;
  background:none;
  border-radius:var(--radius-md);
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--text-sub);
  transition:background var(--transition-fast), color var(--transition-fast);
}
.icon-btn:hover{ background:var(--bg-page); color:var(--text-main); }
.icon-btn svg{ width:20px; height:20px; }

.bell-btn .badge{
  position:absolute;
  top:2px; right:2px;
  background:var(--accent-red);
  color:#fff;
  font-size:.62rem;
  font-weight:700;
  width:16px; height:16px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
}

.avatar-placeholder{
  width:36px; height:36px;
  border-radius:50%;
  border:1px solid var(--border-color);
  background:var(--bg-page);
  flex-shrink:0;
}

/* ===== SIDEBAR ===== */
.sidebar{
  position:fixed;
  top:var(--navbar-h);
  left:0; bottom:0;
  width:var(--sidebar-w);
  background:var(--bg-sidebar);
  display:flex;
  flex-direction:column;
  overflow-y:auto;
  overflow-x:hidden;
  padding:20px 12px;
  padding-left:max(12px, env(safe-area-inset-left));
  padding-bottom:max(12px, env(safe-area-inset-bottom));
  z-index:90;
  transition:width var(--transition-medium), transform var(--transition-medium), top var(--transition-medium);
}

.sidebar-header{
  display:none;
  padding:0 14px 14px;
  margin-bottom:6px;
  border-bottom:1px solid var(--border);
}
.sidebar-header .brand-text{
  font-size:clamp(1.05rem, 4vw, 1.2rem);
}

.nav-list{ display:flex; flex-direction:column; gap:6px; flex:1; min-height:0; }

.nav-item{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  min-height:var(--nav-min-h);
  padding:10px 14px;
  border:none;
  background:none;
  border-radius:var(--radius-md);
  color:var(--text-sub);
  font-family:var(--font-sans);
  font-size:.92rem;
  font-weight:600;
  text-align:left;
  white-space:nowrap;
  transition:background var(--transition-fast), color var(--transition-fast);
}

.nav-item:hover{ background:var(--bg-page); }
.nav-item.active{ background:var(--background); color:var(--accent); }

.nav-icon{ width:20px; height:20px; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
.nav-icon svg { width:20px; height:20px; fill: var(--text-secondary); color: var(--text-secondary); }

.nav-item.active .nav-icon svg { width:20px; height:20px; fill:var(--accent); color: var(--accent);  }

.nav-label{ flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; }

.nav-chevron{ width:16px; height:16px; margin-left:auto; flex-shrink:0; transition:transform var(--transition-fast); }
.nav-parent.open .nav-chevron{ transform:rotate(180deg); }

.nav-submenu{
  max-height:0;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  gap:4px;
  padding-left:20px;
  border-left:2px solid var(--border);
  transition:max-height var(--transition-medium);
}
.nav-submenu.open{
  max-height:min(400px, calc(100vh - var(--navbar-h)));
  overflow-y:auto;
  margin:2px 0 6px;
}

.sub-nav-item{
  display:flex;
  align-items:center;
  gap:10px;
  min-height:var(--sub-nav-min-h);
  padding:10px 12px;
  font-size:.85rem;
  font-weight:500;
  color:var(--text-sub);
  border-radius:8px;
  white-space:nowrap;
  transition:background var(--transition-fast), color var(--transition-fast);
}
.sub-nav-item:hover{ background:var(--bg-page); color:var(--text-main); }
.sub-nav-item.active{ color:var(--accent); font-weight:700; }
.sub-nav-icon{
  min-width:25px;
  min-height:22px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:rgba(196,155,60,0.12);
  color:var(--accent-blue);
  font-size:1rem;
  font-weight:700;
  flex-shrink:0;
}
.sub-nav-label{ overflow:hidden; text-overflow:ellipsis; }

.nav-label--wrap{ white-space:normal; overflow:visible; text-overflow:clip; line-height:1.35; }

.content-text{
  padding:2rem 1.5rem;
  color:var(--text-main);
  font-size:1rem;
  line-height:1.8;
}
.content-text p{ margin-bottom:1rem; }

.content-text h3{
  margin:1.75rem 0 .5rem;
  font-size:1.1rem;
  color:var(--accent);
}
.content-text h3:first-child{ margin-top:0; }
.content-text ul{
  margin:0 0 1.25rem;
  padding-left:1.35rem;
}
.content-text li{
  margin-bottom:.55rem;
  line-height:1.7;
}
.content-text li a{
  color:var(--accent-blue);
  text-decoration:none;
  border-bottom:1px solid transparent;
  transition:border-color var(--transition-fast), color var(--transition-fast);
}
.content-text li a:hover{
  color:var(--accent);
  border-bottom-color:var(--accent);
}

.content-card-body:has(.content-text:not([hidden])) {
  display: block;
  height: auto;
  min-height: 40vh;
  overflow: visible;
  padding: 0;
}

.content-card-body:has(.content-text:not([hidden])) .content-text {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
}

.content-text p,
.content-text li,
.content-text a {
  overflow-wrap: break-word;
  word-break: break-word;
}

.app-shell.sidebar-collapsed .sidebar .sub-nav-item,
.app-shell.sidebar-collapsed .sidebar .sub-nav-icon {
  display: flex;
  justify-content: center;
}
.app-shell.sidebar-collapsed .sub-nav-label{
  display:none;
}
.app-shell.sidebar-collapsed .nav-submenu{
  padding-left:0;
  border-left:none;
}

.sidebar-footer{
  margin-top:auto;
  padding-top:22px;
  border-top:1px solid var(--border);
  display:flex;
  flex-direction:column;
  gap:8px;
}
.sidebar-footer .nav-item{
  background:transparent;
}
.sidebar-footer .nav-item:hover{
  background:var(--bg-page);
}

/* sidebar collapsed = icon only */
.app-shell.sidebar-collapsed .sidebar{ width:var(--sidebar-w-collapsed); padding:20px 10px; }
.app-shell.sidebar-collapsed .nav-item{ justify-content:center; padding:11px 0; }
.app-shell.sidebar-collapsed .nav-label,
.app-shell.sidebar-collapsed .nav-chevron{ display:none; }

.sidebar-backdrop{
  position:fixed; inset:0;
  background:rgba(0,0,0,.35);
  opacity:0;
  pointer-events:none;
  z-index:80;
  transition:opacity var(--transition-medium);
}

/* ===== MAIN CONTENT ===== */
.main-content{
  margin-left:var(--sidebar-w);
  margin-top:var(--navbar-h);
  padding:30px 40px 10px 32px ;
  min-height:calc(100vh - var(--navbar-h));
  transition:margin-left var(--transition-medium), margin-top var(--transition-medium);
  background-color: var(--bg-page);
  border-radius: 24px;
}
.app-shell.sidebar-collapsed .main-content{ margin-left:var(--sidebar-w-collapsed); }

.page-header{ margin-bottom:20px; }
.page-title{ margin:0 0 6px; font-size:1.55rem; font-weight:800; color:var(--text-main); }
.breadcrumb{ margin:0; font-size:.85rem; color:var(--text-sub); }
.breadcrumb #breadcrumbCurrent{ color:var(--accent-blue); font-weight:600; }

.content-card{
  background:var(--bg-card);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-card);
  overflow:hidden;
  margin-bottom: 2rem;
}

.content-card-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px 22px;
  border-bottom:1px solid var(--border-color);
}
.content-card-heading{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:1.05rem;
  font-weight:700;
  color:var(--text-main);
}
.content-card-heading svg{ width:20px; height:20px; color:var(--text-sub); }
.content-card-tools{ display:flex; gap:6px; }

.content-card-body{
  height:calc(100dvh - var(--navbar-h) - 240px);
  min-height:300px;
  overflow-y:auto;
  display: flex;
  justify-content: center;
  align-items: center;
}

.pdf-viewer-wrapper{
    width:100%;
    height:100%;
    min-height:300px;
    overflow: hidden;
}

.pdf-viewer{
    width:100%;
    height:100%;
    border:none;
}

.pagination-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px 30px;
  border-top:1px solid var(--border-color);
}

.page-btn{
  display:flex;
  align-items:center;
  gap:6px;
  padding:9px 16px;
  border:1px solid var(--border-color);
  border-radius:999px;
  background:var(--bg-card);
  font-family:var(--font-sans);
  font-weight:600;
  font-size:.85rem;
  color:var(--text-main);
  transition:border-color var(--transition-fast), color var(--transition-fast);
}
.page-btn:hover{ border-color:var(--accent-blue); color:var(--accent-blue); }
.page-btn:disabled{ opacity:.4; cursor:not-allowed; }
.page-btn svg{ width:16px; height:16px; }

.page-dots{ display:flex; gap:6px; }
.page-dot{
  width:8px; height:8px;
  border-radius:50%;
  background:var(--border-color);
  transition:background var(--transition-fast), transform var(--transition-fast);
}
.page-dot.active{ background:var(--accent-blue); transform:scale(1.3); }

/* ===== RESPONSIVE / MOBILE ===== */
@media (max-width:768px){
  .content-card-heading svg {
    display: none;
  }

  .sidebar-header{
    display:block;
  }

  .topnav{
    padding: 0 16px;
  }
  .topnav-left{
    flex:1 1 auto;
    min-width:0;
  }
  .topnav-right{
    flex:0 0 auto;
  }
  .brand{
    flex:0 0 auto;
  }
  .brand-text{
    font-size:clamp(0.95rem, 4vw, 1.15rem);
  }
  .hamburger-btn{
    flex-shrink:0;
    margin-left:1rem;
    width:44px;
    height:44px;
  }
  .search-bar{
    display:none;
  }

  .sidebar{
    width:var(--sidebar-w-mobile);
    transform:translateX(-100%);
  }
  .app-shell.sidebar-collapsed .sidebar{
    width:var(--sidebar-w-mobile);
    transform:translateX(0);
    padding:20px 12px;
    padding-left:max(12px, env(safe-area-inset-left));
    padding-bottom:max(12px, env(safe-area-inset-bottom));
  }
  .app-shell.sidebar-collapsed .sidebar .nav-label,
  .app-shell.sidebar-collapsed .sidebar .nav-chevron{
    display:block;
  }
  .app-shell.sidebar-collapsed .sidebar .nav-item{
    justify-content:flex-start;
    padding:11px 14px;
  }

  .app-shell.sidebar-collapsed .sidebar-backdrop{
    opacity:1;
    pointer-events:auto;
  }

  .main-content{ margin-left:0; padding:24px; }
  .app-shell.sidebar-collapsed .main-content{ margin-left:0; }

  .content-card-body{ padding:20px; }
}

/* ===== RESPONSIVE FINE-TUNE UNTUK PERIODISASI ===== */
@media (max-width: 480px) {
  .topnav {
    padding: 0 10px;
  }
  .topnav-left {
    gap: 0.25rem;
  }
  .brand-text {
    font-size: clamp(0.9rem, 3.8vw, 1rem);
  }
  .hamburger-btn {
    margin-left: 0.25rem;
    width: 40px;
    height: 40px;
  }
  .hamburger-btn svg {
    width: 18px;
    height: 18px;
  }
  .topnav-right {
    gap: 8px;
  }
  .theme-switch {
    width: 48px;
    height: 28px;
  }
  .theme-switch__thumb {
    width: 20px;
    height: 20px;
  }
  .theme-switch.active .theme-switch__thumb {
    transform: translateX(20px);
  }
  .avatar-placeholder {
    width: 28px;
    height: 28px;
  }
  .main-content {
    padding: 16px 12px;
  }
  .page-title {
    font-size: 1.2rem;
  }
  .breadcrumb {
    font-size: 0.75rem;
  }
  .content-card-header {
    padding: 12px 16px;
    flex-wrap: wrap;
  }
  .content-card-heading {
    font-size: 0.95rem;
  }
  .content-card-heading svg {
    width: 16px;
    height: 16px;
  }
  .content-card-body {
    padding: 16px;
    overflow: hidden;
  }
  .image-placeholder {
    max-width: 100%;
    height: 140px;
    margin-bottom: 16px;
    font-size: 0.8rem;
  }
  .content-text {
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .content-card-body:has(.content-text:not([hidden])) .content-text {
    padding: 1.25rem 1rem;
  }
  .pagination-bar {
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 16px;
    justify-content: center;
  }
  .page-btn {
    padding: 6px 12px;
    font-size: 0.75rem;
  }
  .page-btn svg {
    width: 14px;
    height: 14px;
  }
  .page-dots {
    gap: 4px;
  }
  .page-dot {
    width: 6px;
    height: 6px;
  }
  .nav-item {
    font-size: 0.9rem;
  }
  .sub-nav-item {
    font-size: 0.82rem;
  }
  .sub-nav-icon {
    min-width: 22px;
    min-height: 20px;
    font-size: 0.85rem;
  }
}

@media (max-width: 400px) {
  .avatar-placeholder {
    display: none;
  }
  .theme-switch {
    width: 40px;
    height: 26px;
  }
  .theme-switch__thumb {
    width: 18px;
    height: 18px;
  }
  .theme-switch.active .theme-switch__thumb {
    transform: translateX(14px);
  }
}

@media (max-width: 380px) {
  .page-title {
    font-size: 1rem;
  }
  .content-card-body {
    padding: 12px;
  }
  .pagination-bar {
    justify-content: space-between;
    align-items: center;
  }
  .page-btn {
    justify-content: center;
    padding: 6px 8px;
    width: 30px;
    font-size: 0.5rem;
  }
  .page-btn span {
    display: none;
  }
}

@media (max-width: 1024px) {
  .main-content {
    padding: 24px 20px 8px;
  }
  .page-title {
    font-size: 1.35rem;
  }
  .content-card-heading {
    font-size: 0.98rem;
  }
}

/* ===== TOUCH DEVICE ===== */
@media (hover:none){
  .cursor{
    display:none;
  }
  *{
    cursor:auto !important;
  }
}